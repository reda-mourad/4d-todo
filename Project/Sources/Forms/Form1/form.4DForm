{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"events": [
		"onLoad",
		"onClick",
		"onDoubleClick",
		"onDataChange"
	],
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"lbTodos": {
					"type": "listbox",
					"left": 20,
					"top": 99,
					"width": 1279,
					"height": 536,
					"events": [
						"onClick",
						"onDoubleClick"
					],
					"listboxType": "collection",
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"dataSource": "Form:C1466.todos",
					"sizingX": "grow",
					"sizingY": "grow",
					"currentItemSource": "Form:C1466.selectedTodo",
					"rowFillSource": "This:C1470.completed_at ? lk inherited : (This:C1470.due_date=Null ? lk inherited : ((This:C1470.due_date-Current date)<1 ? \"#FECACA\" : ((This:C1470.due_date-Current date)<2 ? \"#FED7AA\" : lk inherited)))",
					"rowStrokeSource": "This:C1470.completed_at ? \"#9CA3AF\" : \"#111827\"",
					"rowStyleSource": "This:C1470.todoCategories.category.extract(\"label\").indexOf(\"Urgent\")#-1 ? Bold:K14:2 : Plain:K14:1",
					"selectionMode": "single",
					"hideSystemHighlight": true,
					"resizingMode": "legacy",
					"horizontalPadding": 5,
					"verticalPadding": 5,
					"verticalLineStroke": "transparent",
					"alternateFill": "automaticAlternate",
					"columns": [
						{
							"header": {
								"name": "Header4",
								"text": "Statut"
							},
							"name": "Column4",
							"dataSource": "This:C1470.completed_at ? \"✔️\" : (This:C1470.todoCategories.category.extract(\"label\").indexOf(\"Urgent\")#-1 ? \"🚨\" : \"⚠️\")",
							"footer": {
								"name": "Footer4"
							},
							"width": 50,
							"textAlign": "center",
							"fontStyle": "normal",
							"fontSize": 18,
							"enterable": false
						},
						{
							"header": {
								"text": "Tâche",
								"name": "Header2"
							},
							"name": "Column2",
							"footer": {
								"name": "Footer2"
							},
							"dataSource": "This:C1470.label",
							"width": 300,
							"textAlign": "left",
							"enterable": false,
							"rowHeightAuto": true
						},
						{
							"header": {
								"name": "Header8",
								"text": "Catégories"
							},
							"name": "Column8",
							"dataSource": "This:C1470.todoCategories.category.extract(\"label\").join(\", \")",
							"footer": {
								"name": "Footer8"
							},
							"width": 200,
							"textAlign": "left",
							"enterable": false
						},
						{
							"header": {
								"name": "Header5",
								"text": "Patient"
							},
							"name": "Column5",
							"dataSource": "String:C10(This:C1470.patient.Nom)+\" \"+String:C10(This:C1470.patient.Prénom)",
							"footer": {
								"name": "Footer5"
							},
							"width": 150,
							"textAlign": "left",
							"enterable": false
						},
						{
							"header": {
								"name": "Header3",
								"text": "Attribué à"
							},
							"name": "Column3",
							"dataSource": "This:C1470.assignee.Nom",
							"footer": {
								"name": "Footer3"
							},
							"width": 150,
							"textAlign": "left",
							"enterable": false
						},
						{
							"header": {
								"name": "Header9",
								"text": "Créé par"
							},
							"name": "Column9",
							"dataSource": "This:C1470.creator.Nom",
							"footer": {
								"name": "Footer9"
							},
							"width": 150,
							"textAlign": "left",
							"enterable": false
						},
						{
							"header": {
								"name": "Header6",
								"text": "Echéance"
							},
							"name": "Column6",
							"dataSource": "This:C1470.due_date",
							"dataSourceTypeHint": "date",
							"footer": {
								"name": "Footer6"
							},
							"textAlign": "left",
							"enterable": false,
							"width": 100
						},
						{
							"header": {
								"name": "Header7",
								"text": "Clôture"
							},
							"name": "Column7",
							"dataSource": "This:C1470.completed_at ? [String:C10(cs:C1710.Timestamp.me.stampToDate(This:C1470.completed_at)); String:C10(cs:C1710.Timestamp.me.stampToTime(This:C1470.completed_at))].join(\" - \") : \"\"",
							"footer": {
								"name": "Footer7"
							},
							"width": 150,
							"textAlign": "left",
							"enterable": false
						}
					]
				},
				"Rectangle": {
					"type": "rectangle",
					"top": 20,
					"left": 20,
					"width": 700,
					"height": 30,
					"borderRadius": 30,
					"stroke": "#c0c0c0"
				},
				"inputSearch": {
					"type": "input",
					"left": 30,
					"top": 26,
					"width": 680,
					"height": 18,
					"placeholder": "🔍 Rechercher une tâche, un patient, un membre du personnel ou une catégorie",
					"dataSource": "Form:C1466.search",
					"events": [
						"onDataChange"
					],
					"fill": "transparent",
					"borderStyle": "none"
				},
				"rdoOnlyMine": {
					"type": "radio",
					"left": 147,
					"top": 64,
					"width": 111,
					"height": 15,
					"text": "Mes tâches à faire",
					"dataSource": "Form:C1466.onlyMyTodos",
					"radioGroup": "taskScope",
					"events": [
						"onClick",
						"onDataChange"
					]
				},
				"chkOnlyToday": {
					"type": "checkbox",
					"left": 449,
					"top": 64,
					"width": 128,
					"height": 15,
					"text": "Tâches d'aujourd'hui",
					"dataSource": "Form:C1466.onlyTodayTodos",
					"events": [
						"onDataChange"
					]
				},
				"Rectangle1": {
					"type": "rectangle",
					"top": 20,
					"left": 1049,
					"width": 200,
					"height": 30,
					"borderRadius": 30,
					"fill": "#324E74",
					"sizingX": "move",
					"stroke": "#324E74"
				},
				"progress": {
					"type": "rectangle",
					"top": 21,
					"left": 1050,
					"width": 118,
					"height": 28,
					"borderRadius": 28,
					"fill": "#6495ed",
					"stroke": "transparent",
					"sizingX": "move"
				},
				"Input1": {
					"type": "input",
					"left": 1059,
					"top": 26,
					"width": 180,
					"height": 18,
					"fill": "transparent",
					"borderStyle": "none",
					"dataSource": "Form:C1466.progressLabel",
					"sizingX": "move",
					"textAlign": "center",
					"stroke": "#FFFFFF",
					"enterable": false,
					"focusable": false
				},
				"Rectangle3": {
					"type": "rectangle",
					"top": 20,
					"left": 1269,
					"width": 30,
					"height": 30,
					"borderRadius": 15,
					"stroke": "#c0c0c0",
					"sizingX": "move"
				},
				"btnAdd": {
					"type": "button",
					"text": "➕ ",
					"top": 20,
					"left": 1269,
					"width": 30,
					"height": 30,
					"events": [
						"onClick"
					],
					"style": "custom",
					"sizingX": "move"
				},
				"rdoOnlyCreated": {
					"type": "radio",
					"left": 278,
					"top": 64,
					"width": 151,
					"height": 15,
					"text": "Tâches que j'ai déléguées",
					"dataSource": "Form:C1466.onlyCreatedTodos",
					"radioGroup": "taskScope",
					"events": [
						"onClick",
						"onDataChange"
					]
				},
				"rdoAllTodos": {
					"type": "radio",
					"left": 20,
					"top": 64,
					"width": 107,
					"height": 15,
					"text": "Toutes les tâches",
					"dataSource": "Form:C1466.allTodos",
					"radioGroup": "taskScope",
					"events": [
						"onClick",
						"onDataChange"
					]
				},
				"chkOnlyOpen": {
					"type": "checkbox",
					"left": 597,
					"top": 64,
					"width": 105,
					"height": 15,
					"text": "Tâches clôturées",
					"dataSource": "Form:C1466.onlyOpen",
					"events": [
						"onClick",
						"onDataChange"
					]
				}
			},
			"entryOrder": [
				"inputSearch",
				"btnAdd",
				"rdoAllTodos",
				"rdoOnlyMine",
				"rdoOnlyCreated",
				"chkOnlyToday",
				"chkOnlyOpen",
				"lbTodos",
				"Input1"
			]
		}
	],
	"geometryStamp": 312,
	"formClass": "TodoForm",
	"editor": {
		"groups": {
			"Group": [
				"Rectangle",
				"inputSearch"
			],
			"Group2": [
				"rdoOnlyMine",
				"rdoOnlyCreated",
				"rdoAllTodos"
			],
			"Group4": [
				"chkOnlyToday",
				"chkOnlyOpen"
			],
			"Group5": [
				"Rectangle1",
				"progress",
				"Input1",
				"Rectangle3",
				"btnAdd"
			]
		},
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"method": "method.4dm",
	"rightMargin": 20,
	"bottomMargin": 20,
	"windowSizingX": "fixed",
	"windowSizingY": "fixed"
}